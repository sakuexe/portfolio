# Dev-only config, committed. Vite loads it in `astro dev` only, never in
# `astro build`, so production can't fall back to these. Personal overrides go
# in `.env.development.local` (gitignored).

# Cloudflare's always-pass test site key.
TURNSTILE_SITE_KEY=1x00000000000000000000AA

# smtp4dev from the dev flake: SMTP on localhost:2525, inbox at localhost:5000.
SMTP_HOST=localhost
SMTP_PORT=2525
MAIL_FROM=website@localhost
MAIL_TO=saku@localhost
