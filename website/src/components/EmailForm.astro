---
import { TURNSTILE_SITE_KEY } from "astro:env/client";
import { limits } from "@/actions/models";
import FormLoader from "./forms/FormLoader.astro";
import FormResult from "./forms/FormResult.astro";
import "../styles/forms.css";
---

<!-- Native validation catches the common cases instantly; the `contact`
     Action's Zod messages land in the [data-error-for] slots. -->
<form id="email-form" method="POST">
	<label>
		Name
    <input
      type="text"
      id="name"
      name="name"
      placeholder="Firstname Lastname"
      autocomplete="name"
      maxlength={limits.name}
      aria-describedby="name-error"
      required
    />
    <span class="field-error" id="name-error" data-error-for="name"></span>
	</label>

	<label>
		Email
    <input
      type="email"
      id="email"
      name="email"
      placeholder="example@gmail.com"
      autocomplete="email"
      aria-describedby="email-error"
      required
    />
    <span class="field-error" id="email-error" data-error-for="email"></span>
	</label>

	<label>
		Subject
    <input
      type="text"
      id="subject"
      name="subject"
      placeholder="Cool website! 😎"
      maxlength={limits.subject}
      aria-describedby="subject-error"
    />
    <span class="field-error" id="subject-error" data-error-for="subject"></span>
	</label>

	<label>
		Message
    <textarea
      id="message"
      name="message"
      placeholder="The message..."
      maxlength={limits.message}
      aria-describedby="message-error"
      required
		></textarea>
    <span class="field-error" id="message-error" data-error-for="message"></span>
	</label>

	<!-- Honeypot. Looks like a real optional field to a bot, but no autofill
	     dictionary maps "referral", so real users' autofill leaves it empty. -->
	<label class="referral" aria-hidden="true">
		How did you find me?
		<input
			type="text"
			name="referral"
			placeholder="A friend, a search, a business card…"
			tabindex="-1"
			autocomplete="off"
		/>
	</label>

	<!-- Rendered on the first focus inside the form (see the script), so
	     visitors who never use the form never contact Cloudflare. Invisible
	     mode is set on the widget in the Cloudflare dashboard. It adds the
	     `cf-turnstile-response` field to the form. -->
	<div class="turnstile" data-sitekey={TURNSTILE_SITE_KEY}></div>
	<p class="text-sm opacity-75">
    Protected by Cloudflare Turnstile. 
    See the <a href="/privacy/">privacy policy</a> for 
    what happens to your message.
	</p>

	<hr />

  <!-- buttons -->
	<button type="submit"
    class="primary">
		Send
	</button>
	<button type="reset" class="secondary">
		Clear
	</button>

  <FormLoader text="Sending email" />
  <FormResult
    successMessage="Thank you for submitting the email! I will get back to you shortly."
  />
</form>

<script>
  import { actions, isInputError } from "astro:actions";

  // From the Turnstile script, once loadTurnstile() has added it.
  declare const turnstile: {
    render(container: Element, params: Record<string, unknown>): string;
    reset(container: Element): void;
  };

  const form = document.querySelector<HTMLFormElement>("form#email-form");
  if (!form) throw new Error("form#email-form was not found");
  const widget = form.querySelector<HTMLElement>(".turnstile")!;
  const errorMessage = form.querySelector(".form-result .error-message")!;
  const defaultErrorMessage = errorMessage.textContent;

  // Resolves once the widget has put a token in the form. Replaced whenever
  // the token is spent or expires, so a submit always waits for a fresh one.
  let tokenReady: Promise<true> | undefined;
  let resolveToken: (ready: true) => void;

  function awaitNewToken() {
    tokenReady = new Promise((resolve) => (resolveToken = resolve));
  }

  function loadTurnstile() {
    if (tokenReady) return;
    awaitNewToken();
    const script = document.createElement("script");
    script.src =
      "https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit";
    script.onload = () =>
      turnstile.render(widget, {
        sitekey: widget.dataset.sitekey,
        action: "contact",
        callback: () => resolveToken(true),
        "expired-callback": awaitNewToken,
      });
    document.head.append(script);
  }

  function resetTurnstile() {
    awaitNewToken();
    turnstile.reset(widget);
  }

  /** False if no token arrives in time: blocked script, or a turned-away visitor. */
  function waitForToken() {
    loadTurnstile();
    const timeout = new Promise<false>((resolve) =>
      setTimeout(resolve, 15_000, false),
    );
    return Promise.race([tokenReady!, timeout]);
  }

  form.addEventListener("focusin", loadTurnstile, { once: true });

  function setFieldError(name: string, message?: string) {
    const slot = form!.querySelector(`[data-error-for="${name}"]`);
    const field = form!.elements.namedItem(name);
    if (slot) slot.textContent = message ?? "";
    // Not toggleAttribute: aria-invalid="" means false.
    if (field instanceof HTMLElement) {
      if (message) field.setAttribute("aria-invalid", "true");
      else field.removeAttribute("aria-invalid");
    }
  }

  function clearFieldErrors() {
    for (const slot of form!.querySelectorAll<HTMLElement>("[data-error-for]")) {
      setFieldError(slot.dataset.errorFor!);
    }
  }

  function showError(message?: string) {
    errorMessage.textContent = message ?? defaultErrorMessage;
    form!.classList.add("error");
  }

  // A field's error goes away as soon as it's edited.
  form.addEventListener("input", (e) => {
    const target = e.target as HTMLInputElement;
    if (target.name) setFieldError(target.name);
  });
  form.addEventListener("reset", clearFieldErrors);

  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    clearFieldErrors();

    form.classList.add("loading");
    // Usually done long before the visitor hits Send.
    if (!(await waitForToken())) {
      form.classList.remove("loading");
      return showError(
        "We couldn't verify that you're human. Please reload the page and try again.",
      );
    }
    const { error } = await actions.contact(new FormData(form));
    form.classList.remove("loading");

    if (!error) {
      form.reset();
      resetTurnstile();
      form.classList.add("success");
      return;
    }

    if (isInputError(error)) {
      // Validation runs before the handler, so the token wasn't spent and
      // the visitor can fix the field and resend without a new challenge.
      for (const [name, messages] of Object.entries(error.fields)) {
        setFieldError(name, messages?.[0]);
      }
      const visible = Object.keys(error.fields).find((name) =>
        form.querySelector(`[data-error-for="${name}"]`),
      );
      if (visible) {
        (form.elements.namedItem(visible) as HTMLElement | null)?.focus();
        return;
      }
      // Only the hidden Turnstile field failed.
      return showError(error.fields["cf-turnstile-response"]?.[0]);
    }

    // The handler ran, so siteverify may have spent the token.
    resetTurnstile();
    console.error(error);
    // Only messages written for visitors; the rest get the generic one.
    showError(error.code === "FORBIDDEN" ? error.message : undefined);
  });
</script>

<style>
  .field-error {
    color: var(--color-accent);
    font-size: 0.875rem;
    &:empty {
      display: none;
    }
  }

  input[aria-invalid],
  textarea[aria-invalid] {
    border-color: var(--color-accent);
  }

  /* Off the start edge, so it never adds a horizontal scrollbar. Not
     display:none / visibility:hidden, which bots check for. */
  .referral {
    position: absolute;
    top: 0;
    left: 0;
    transform: translateX(-100vw);
  }
</style>
