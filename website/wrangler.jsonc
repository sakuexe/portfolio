// Only what the adapter doesn't generate. The build writes the full config,
// which `wrangler deploy` picks up through .wrangler/deploy/config.json.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "portfolio",
  "compatibility_date": "2026-11-01",
  // worker-mailer needs it.
  "compatibility_flags": ["nodejs_compat"],
  // Cloudflare creates the DNS record and certificate. It can't be created
  // over an existing record for the hostname (see MIGRATION_PLAN.md, step 5).
  "routes": [{ "pattern": "sakukarttunen.com", "custom_domain": true }],
  // Serve only on the custom domain, not on *.workers.dev.
  "workers_dev": false,
  "preview_urls": false,
  // Every page is prerendered, so the Worker only needs to run for Actions.
  // Unmatched paths get 404.html from the asset layer instead of invoking the
  // Worker (which bots probing for .env etc. would otherwise do on every hit).
  "assets": {
    "not_found_handling": "404-page",
    "run_worker_first": ["/_actions/*"],
  },
  // Keeps Worker logs, so the contact Action's console.error/warn calls can be
  // read after the fact.
  "observability": { "enabled": true },
}
